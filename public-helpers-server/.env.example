# The VPS's reserved public IPv4 address, without https:// or a trailing slash.
PUBLIC_HELPERS_ADDRESS=203.0.113.10

# Use a reviewed Hypixel Production application key before public release.
HYPIXEL_API_KEY=replace-with-your-hypixel-production-key

# Generate with: openssl rand -hex 32
# This is an application access token, not a substitute for server-side rate limits.
PUBLIC_HELPERS_TOKEN=replace-with-at-least-24-random-characters

# Defaults are safe for a 300-request/5-minute Hypixel allowance.
HYPIXEL_REQUEST_LIMIT=280
CLIENT_REQUEST_LIMIT=240
GLOBAL_REQUEST_LIMIT=10000
RATE_WINDOW_MS=300000
CACHE_TTL_MS=3600000
STALE_TTL_MS=86400000
